
PRIVATE @Буфер array

USE TRANSACTION 'PG_TEST'

  SELECT Ссылка, Код, Наименование, ПометкаУдаления, Предопределенный
       , Булево, Число, Дата, Строка, ОднаСсылка, МногоСсылок, Перечисление
    INTO @Буфер
    FROM Справочник.Тестовый

  USE TRANSACTION 'MS_TEST'
    INSERT Справочник.Тестовый FROM @Буфер
    SELECT Ссылка           = @Буфер.Ссылка
         , Код              = @Буфер.Код
         , Наименование     = @Буфер.Наименование
         , ПометкаУдаления  = @Буфер.ПометкаУдаления
         , Предопределенный = @Буфер.Предопределенный
         , Булево           = @Буфер.Булево
         , Число            = @Буфер.Число
         , Дата             = @Буфер.Дата
         , Строка           = @Буфер.Строка
         , ОднаСсылка       = @Буфер.ОднаСсылка
         , МногоСсылок      = @Буфер.МногоСсылок
         , Перечисление     = @Буфер.Перечисление
  END

END

RETURN '[BULK INSERT] справочник "Тестовый"'