
DECLARE @Ссылка uuid = '151805a8-431a-43ea-95a9-c49566289932' -- Перечисление.ВидНоменклатуры.Товар

PRIVATE @Таблица array

PRINT 'INPUT = ' + @Ссылка

USE 'PG_TEST' -- 'MS_TEST'

  SELECT TOP 1 Наименование
       , Вид, Вид1С = UUID1C(Вид)
       , ENUM_DB = Перечисление.ВидНоменклатуры.Товар
       , ENUM_1C = UUID1C(Перечисление.ВидНоменклатуры.Товар)
    INTO @Таблица
    FROM Справочник.Номенклатура
   WHERE Вид = UUIDDB(@Ссылка)

END

RETURN @Таблица