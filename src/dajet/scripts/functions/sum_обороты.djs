
DECLARE @Таблица array

DECLARE @Код string  = '000000001'

USE 'MS_TEST'

  SELECT Номенклатура  --Период, Регистратор, Номенклатура, Количество
       , Сумма      = SUM(Количество)
       , Минимум    = MIN(Количество)
       , Максимум   = MAX(Количество)
       , Среднее    = AVG(Количество)
       , Количество = COUNT(*)
    INTO @Таблица
    FROM РегистрНакопления.Обороты
   GROUP BY Номенклатура

END

RETURN JSON(@Таблица)