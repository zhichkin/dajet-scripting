
DECLARE @Таблица  array
DECLARE @Документ object
DECLARE @Номер    string  = '000000001'

USE 'MS_TEST'
  
  SELECT Период, Регистратор, Измерение1, Ресурс1, Реквизит1
    INTO @Таблица
    FROM РегистрНакопления.РегистрНакопления1 AS Регистр
   INNER JOIN Документ.Документ1 AS Документ
      ON Регистр.Регистратор = Документ.Ссылка
   WHERE Документ.Номер = @Номер

END

RETURN @Таблица